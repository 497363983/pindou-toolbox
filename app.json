{
  "expo": {
    "name": "拼豆图纸",
    "slug": "pindou-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tianwei.beadpattern"
    },
    "android": {
      "package": "com.tianwei.beadpattern",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F6F4EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "允许保存拼豆图纸到相册",
          "savePhotosPermission": "允许保存拼豆图纸到相册",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许选择图片以生成拼豆图纸",
          "cameraPermission": "允许拍照以生成拼豆图纸"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f920e107-1007-46af-8f01-9109ccb04644"
      }
    }
  }
}
